rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Family registry: create (new family) and read (join check) allowed.
    match /families/{code} {
      allow read, create: if true;
      allow update, delete: if false;

      // Device tokens for push notifications, isolated per family
      match /devices/{token} {
        allow read, write: if request.resource.data.familyCode == code
                           || resource.data.familyCode == code;
      }
    }

    // Reminders: isolated per family code
    match /reminders/{id} {
      allow read: if resource.data.familyCode is string
                  && resource.data.familyCode.size() == 6;
      allow create: if request.resource.data.familyCode is string
                    && request.resource.data.familyCode.size() == 6
                    && request.resource.data.status == "pending"
                    && request.resource.data.medicineName is string
                    && request.resource.data.medicineName.size() <= 100
                    && request.resource.data.reminderTime is string
                    && request.resource.data.audioUrl is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'completed'];
      allow delete: if resource.data.familyCode is string;
    }
  }
}
